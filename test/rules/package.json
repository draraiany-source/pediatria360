{
  "name": "pediatria360-rules-tests",
  "private": true,
  "description": "Testes das regras de seguranca do Firestore",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project pediatria360-rules-test \"jest --runInBand\"",
    "test:watch": "firebase emulators:exec --only firestore,storage --project pediatria360-rules-test \"jest --watch --runInBand\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
