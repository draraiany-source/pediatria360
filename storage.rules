rules_version = '2';

// Regras do Firebase Storage.
//
// Imagens de crianças e comprovantes de vacina são dado sensível de menor.
// O acesso é estritamente do dono — não há leitura pública em nenhum caminho
// de usuário.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // 8 MB: uma foto de celular moderno cabe; um vídeo, não. Vídeo vai para o
    // Bunny, que é feito para isso e custa uma fração.
    function withinSizeLimit() {
      return request.resource.size < 8 * 1024 * 1024;
    }

    // Fotos de perfil e de crianças, comprovantes de vacina.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImage() && withinSizeLimit();
      allow delete: if isOwner(uid);
    }

    // Capas de curso e imagens de artigo: leitura livre (aparecem antes do
    // login, na vitrine), escrita só por admin via console ou Function.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
