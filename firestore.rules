rules_version = '2';

// Regras de segurança do Pediatria 360.
//
// Princípio: o cliente é hostil. Todo filtro que existe no app existe também
// aqui — o do app é conveniência, este é a garantia. Se as duas discordarem,
// esta vence.
//
// Teste antes de publicar:
//   firebase emulators:exec --only firestore "npm test"

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ Auxiliares

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // `Encounter.patientId` é o id da CRIANÇA, não do responsável — o
    // repositório sempre grava `patientId: child.id`. Comparar
    // `patientId == request.auth.uid` (como a regra de encounters fazia
    // antes desta correção) nunca bate: são dois tipos de id diferentes,
    // documento de criança contra uid de usuário. Só existe um jeito de
    // confirmar "este usuário é responsável por esta criança": checar se
    // ela existe na subcoleção de crianças dele.
    //
    // So que o dono grava qualquer id na propria subcolecao: sem mais nada,
    // quem soubesse o id de uma crianca criaria um documento com esse id e
    // passaria a ler o prontuario dela. child_registry/{childId} guarda o
    // dono, gravado uma unica vez junto com a crianca; quando existe, vale
    // ele. O caminho antigo so resta para criancas ainda sem registro (rodar
    // tools/migrations/backfill_child_registry.js antes de publicar).
    function childRegistryPath(childId) {
      return /databases/$(database)/documents/child_registry/$(childId);
    }

    function ownsChild(childId) {
      return signedIn() && (
        exists(childRegistryPath(childId))
          ? get(childRegistryPath(childId)).data.ownerUid == request.auth.uid
          : exists(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(childId))
      );
    }

    // Responsavel secundario com autorizacao ativa e canViewData.
    function isLinkedGuardianOf(ownerUid, childId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/users/$(ownerUid)/children/$(childId)/guardians/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(ownerUid)/children/$(childId)/guardians/$(request.auth.uid)).data.status == 'active' &&
             get(/databases/$(database)/documents/users/$(ownerUid)/children/$(childId)/guardians/$(request.auth.uid)).data.get('canViewData', false) == true;
    }

    function canReadChildCadastro(ownerUid, childId) {
      return isOwner(ownerUid) ||
             isLinkedGuardianOf(ownerUid, childId) ||
             (isVerifiedProfessional() &&
              exists(/databases/$(database)/documents/users/$(ownerUid)/children/$(childId)/authorized_professionals/$(request.auth.uid)));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return signedIn() ? userDoc().get('role', 'parent') : 'none';
    }

    function isAdmin() {
      // O papel de admin também é checado por custom claim, que não depende de
      // uma leitura extra e não pode ser alterado pelo cliente de forma alguma.
      return signedIn() &&
             (request.auth.token.get('admin', false) == true || role() == 'admin');
    }

    // Profissional só conta como tal depois da conferência do registro.
    function isVerifiedProfessional() {
      return signedIn() &&
             (role() == 'professional' || role() == 'admin') &&
             userDoc().get('professionalVerified', false) == true;
    }

    // Atualizacao de registro clinico: so o autor atual, sem trocar o autor
    // nem o paciente. Conferir so o valor novo deixava qualquer profissional
    // gravar o proprio id num registro alheio e passar a le-lo.
    function isClinicalRecordAuthorUpdate(authorField, patientField) {
      return isVerifiedProfessional() &&
             resource.data.get(authorField, null) == request.auth.uid &&
             request.resource.data.get(authorField, null) == request.auth.uid &&
             request.resource.data.get(patientField, null) ==
               resource.data.get(patientField, null);
    }

    function planActive() {
      return signedIn() && userDoc().get('plan', 'free') != 'free';
    }

    // Campos que só o servidor escreve. Deixar o cliente tocar em `plan` seria
    // dar assinatura grátis a quem souber usar o SDK; em `xp`, ranking forjado.
    function serverOnlyFields() {
      // fcmTokens entrou aqui quando o registro de dispositivo foi
      // centralizado nas Functions registerDevice/unregisterDevice — antes
      // disso o cliente escrevia o array direto, e as duas formas
      // coexistiam sem que nada impedisse divergência entre elas.
      // careSpecialty: especialidade conferida junto com o registro
      // profissional (CRM, CRP, CREFITO...). Decide o que o profissional
      // registra no cuidado multidisciplinar, então só o servidor grava.
      return ['plan', 'planExpiresAt', 'xp', 'streakDays', 'longestStreak',
              'lastStreakDate', 'professionalVerified', 'role', 'fcmTokens',
              'careSpecialty'];
    }

    function notTouchingServerFields() {
      return !request.resource.data.diff(resource.data)
                     .affectedKeys()
                     .hasAny(serverOnlyFields());
    }

    // A conta nasce 'parent'; no onboarding (uma vez) o dono escolhe ser
    // profissional, sempre como nao verificado.
    function isOnboardingRoleChoice() {
      return resource.data.get('onboardingDone', false) != true &&
             request.resource.data.onboardingDone == true &&
             request.resource.data.role in ['parent', 'professional'] &&
             request.resource.data.get('professionalVerified', false) == false &&
             !request.resource.data.diff(resource.data).affectedKeys()
                .difference(['role', 'professionalVerified'].toSet())
                .hasAny(serverOnlyFields());
    }

    function isValidString(field, maxLength) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() <= maxLength;
    }

    // ---------------------------------------------------------------- Users

    // Dono de cada crianca (ver ownsChild). Criado pelo app no mesmo lote da
    // crianca; nunca muda. A leitura de id inexistente e liberada para o app
    // saber se precisa criar o registro numa retentativa de envio.
    match /child_registry/{childId} {
      allow read: if signedIn() &&
                     (resource == null ||
                      resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() &&
                       request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']) &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(childId));
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Criação: o próprio usuário, com plano gratuito e sem privilégios.
      allow create: if isOwner(uid)
                    && request.resource.data.get('plan', 'free') == 'free'
                    && request.resource.data.get('professionalVerified', false) == false
                    && request.resource.data.get('xp', 0) == 0
                    && request.resource.data.get('streakDays', 0) == 0
                    && !request.resource.data.keys().hasAny(
                         ['longestStreak', 'lastStreakDate', 'planExpiresAt'])
                    && request.resource.data.get('role', 'parent') in ['parent', 'professional'];

      // Atualização: o dono pode editar o perfil, mas nunca os campos de
      // servidor. O admin pode tudo (é como o CRM é verificado).
      // Depois de verificado, o CRM impresso nas prescricoes so muda pelo admin.
      allow update: if isAdmin()
                    || (isOwner(uid) &&
                        (notTouchingServerFields() || isOnboardingRoleChoice()) &&
                        (resource.data.get('professionalVerified', false) != true ||
                         !request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny(['crm'])));

      // Exclusão de conta passa pela Function `onUserDeleted`, que apaga em
      // cascata. Apagar só o documento deixaria as subcollections órfãs.
      allow delete: if false;

      // Crianças e todo o dado clínico: exclusivamente do dono.
      // Nem admin lê — prontuário de criança não é dado operacional.
      //
      // Exceção estreita: profissional verificado com uma concessão própria
      // (subcoleção abaixo) lê o cadastro — nome, idade, alergia — mas
      // nunca escreve. A concessão existe porque `_PatientSummaryCard`
      // (resumo de segurança na linha do tempo do profissional) precisa
      // deste dado, e sem ela ficava silenciosamente sem renderizar para
      // todo profissional — o alerta de alergia que motivou o card existir
      // nunca chegava a quem mais precisava vê-lo.
      match /children/{childId} {
        allow read: if canReadChildCadastro(uid, childId);
        // Criacao so com o registro de propriedade no mesmo lote, e so se
        // ninguem registrou esse id antes.
        allow create: if isOwner(uid) &&
                         !exists(childRegistryPath(childId)) &&
                         getAfter(childRegistryPath(childId)).data.ownerUid == uid;
        allow update, delete: if isOwner(uid) &&
                                 (!exists(childRegistryPath(childId)) ||
                                  get(childRegistryPath(childId)).data.ownerUid == uid);

        // Concessao de leitura do cadastro da crianca: so o responsavel
        // (dono) grava. O profissional NAO se auto-concede — isso passa
        // pela Function grantChildSummaryAccess (Admin SDK), apos vinculo
        // com agendamento ativo.
        match /authorized_professionals/{profId} {
          allow read: if isOwner(uid) ||
                         (isVerifiedProfessional() && request.auth.uid == profId);
          allow write: if isOwner(uid);
        }

        // Responsaveis vinculados (FASE 2) — permissoes explicitas.
        match /guardians/{guardianUid} {
          allow read: if isOwner(uid) || request.auth.uid == guardianUid;
          allow create, update: if isOwner(uid) &&
                                 request.resource.data.ownerId == uid &&
                                 request.resource.data.childId == childId &&
                                 request.resource.data.guardianUid == guardianUid;
          allow delete: if false;
        }

        match /change_log/{logId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) &&
                         request.resource.data.actorUid == request.auth.uid;
          allow update, delete: if false;
        }

        // Responsavel vinculado com canViewData so le; quem grava e o dono.
        match /growth_records/{recordId} {
          allow read: if isOwner(uid) || isLinkedGuardianOf(uid, childId);
          allow write: if isOwner(uid);
        }

        match /vaccine_doses/{doseId} {
          allow read: if isOwner(uid) || isLinkedGuardianOf(uid, childId);
          allow write: if isOwner(uid);
        }
      }

      // Indice invertido: criancas vinculadas a um responsavel secundario.
      match /linked_children/{childId} {
        allow read: if isOwner(uid);
        // Gravado pelo dono da crianca ao vincular/revogar o responsavel.
        allow create, update: if signedIn() &&
                               request.resource.data.guardianUid == uid &&
                               request.resource.data.childId == childId &&
                               request.resource.data.ownerId == request.auth.uid &&
                               ownsChild(childId);
        allow delete: if false;
      }

      match /progress/{progressId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false; // servidor
      }

      // Medalhas conquistadas. O dono lê; só a Function concede — se o
      // cliente pudesse escrever, bastaria criar o documento para "ganhar"
      // qualquer medalha.
      match /earned_badges/{badgeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Histórico de consentimento. Legível pelo titular — é o registro do
      // que ele autorizou e quando. Escrita só pela Function, senão o
      // histórico deixaria de provar qualquer coisa.
      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Cota da IA: leitura para mostrar "restam N hoje"; escrita só no
      // servidor, senão qualquer um zeraria o contador.
      match /ai_usage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Cota do assistente clínico (dentro do prontuário) — mesmo motivo da
      // acima. Coleção separada porque é uma cota diferente, com teto
      // próprio, não a mesma do chat dos responsáveis.
      match /clinical_assist_usage/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Memberships multitenant (indice invertido): users/{uid}/clinic_memberships/{clinicId}
      // Escrita so espelhando um doc em clinics/{clinicId}/memberships/{id} —
      // impede forjar vinculo a clinica alheia so alterando o indice invertido.
      match /clinic_memberships/{clinicId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
                               request.resource.data.userId == uid &&
                               request.resource.data.clinicId == clinicId &&
                               request.resource.data.keys().hasAll(
                                 ['id', 'userId', 'clinicId', 'role', 'active']
                               ) &&
                               exists(/databases/$(database)/documents/clinics/$(clinicId)/memberships/$(request.resource.data.id)) &&
                               get(/databases/$(database)/documents/clinics/$(clinicId)/memberships/$(request.resource.data.id)).data.userId == uid &&
                               get(/databases/$(database)/documents/clinics/$(clinicId)/memberships/$(request.resource.data.id)).data.role ==
                                 request.resource.data.role &&
                               get(/databases/$(database)/documents/clinics/$(clinicId)/memberships/$(request.resource.data.id)).data.active ==
                                 request.resource.data.active;
        allow delete: if false;
      }

      match /supplementation/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ------------------------------------------------------------ Biblioteca

    match /articles/{articleId} {
      allow read: if isAdmin()
                  || (resource.data.get('published', false) == true
                      && (resource.data.get('audience', 'everyone') != 'professionals'
                          || isVerifiedProfessional()));

      allow write: if isAdmin();

      // Histórico de versões do conteúdo. Só admin lê — o histórico editorial
      // não interessa ao leitor e pode conter rascunhos não publicados.
      // Escrita só pela Function, que grava o instantâneo na mesma transação
      // da publicação.
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // --------------------------------------------------------------- Cursos

    match /courses/{courseId} {
      allow read: if isAdmin()
                  || (resource.data.get('published', false) == true
                      && (resource.data.get('professionalOnly', false) == false
                          || isVerifiedProfessional()));

      allow write: if isAdmin();

      // A aula é legível se o curso for; o bloqueio de conteúdo pago acontece
      // na URL assinada de reprodução, não na leitura dos metadados — o aluno
      // precisa ver a lista de aulas para decidir assinar.
      match /lessons/{lessonId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // ------------------------------------------------------------------ IA

    match /ai_conversations/{conversationId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Só a Function escreve. Se o cliente pudesse criar mensagens de
      // assistente, seria trivial forjar "a IA disse que pode dar o remédio".
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && get(/databases/$(database)/documents/ai_conversations/$(conversationId))
                         .data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // ------------------------------------------------------- Marketplace

    match /products/{productId} {
      allow read: if resource.data.get('published', false) == true || isAdmin();
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      // Cupom não é legível: descobrir os códigos ativos é o mesmo que
      // conhecer todos os descontos. A validação roda em Function.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.ownerId == request.auth.uid);
      // Preço e status vêm do servidor — o cliente não define quanto paga.
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    function isClinicAgendaStaff(clinicId) {
      return clinicId != null &&
             isClinicMember(clinicId) &&
             clinicRole(clinicId) in
               ['clinicAdmin', 'receptionist', 'physician',
                'healthProfessional', 'technician', 'nursing'];
    }

    function isClinicReceptionOrAdmin(clinicId) {
      return clinicId != null &&
             isClinicMember(clinicId) &&
             clinicRole(clinicId) in ['clinicAdmin', 'receptionist'];
    }

    // ------------------------------------------------------- Telemedicina

    match /appointments/{appointmentId} {
      allow read: if isAdmin()
                  || (signedIn() &&
                      (resource.data.patientId == request.auth.uid ||
                       resource.data.professionalId == request.auth.uid ||
                       (resource.data.clinicId != null &&
                        isClinicAgendaStaff(resource.data.clinicId)) ||
                       (resource.data.childId != null &&
                        resource.data.patientId != null &&
                        isLinkedGuardianOf(resource.data.patientId,
                                           resource.data.childId))));

      allow create: if signedIn() && (
                      // Paciente: so solicitacao, sem campos de clinica/cobranca e
                      // para crianca propria (senao virava vinculo forjado para
                      // grantChildSummaryAccess).
                      (request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.get('status', '') == 'requested' &&
                       !request.resource.data.keys().hasAny(
                         ['clinicId', 'unitId', 'paid', 'priceCents', 'amountCents',
                          'workflowStatus', 'confirmedAt']) &&
                       (!('childId' in request.resource.data) ||
                        ownsChild(request.resource.data.childId))) ||
                      (isVerifiedProfessional() &&
                       request.resource.data.clinicId != null &&
                       isClinicAgendaStaff(request.resource.data.clinicId) &&
                       (isClinicReceptionOrAdmin(request.resource.data.clinicId) ||
                        request.resource.data.professionalId == request.auth.uid) &&
                       request.resource.data.keys().hasAll(
                         ['patientId', 'professionalId', 'startsAt', 'status', 'clinicId']))
                    );

      // Cancelar e do paciente; confirmar/concluir e do profissional;
      // recepcao/admin da clinica podem remarcar/cancelar operacionalmente.
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.patientId == request.auth.uid
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'cancelledAt', 'cancelledBy',
                                       'cancelReason', 'updatedAt']))
                    || (isVerifiedProfessional()
                        && resource.data.professionalId == request.auth.uid)
                    || (isVerifiedProfessional()
                        && resource.data.clinicId != null
                        && isClinicReceptionOrAdmin(resource.data.clinicId)
                        && request.resource.data.clinicId == resource.data.clinicId
                        && request.resource.data.professionalId ==
                             resource.data.professionalId)
                    // Financeiro da clinica so marca o atendimento como pago.
                    || (isVerifiedProfessional()
                        && resource.data.clinicId != null
                        && financeWriteRole(resource.data.clinicId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['paid', 'updatedAt']));

      allow delete: if false;

      match /change_log/{logId} {
        allow read: if isAdmin()
                    || (signedIn() &&
                        (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid ||
                         get(/databases/$(database)/documents/appointments/$(appointmentId)).data.professionalId == request.auth.uid ||
                         (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clinicId != null &&
                          isClinicAgendaStaff(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clinicId))));
        allow create: if signedIn() &&
                       request.resource.data.actorUid == request.auth.uid &&
                       (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid ||
                        get(/databases/$(database)/documents/appointments/$(appointmentId)).data.professionalId == request.auth.uid ||
                        (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.get('clinicId', null) != null &&
                         isClinicAgendaStaff(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clinicId)));
        allow update, delete: if false;
      }
    }

    // O responsável preenche antes da consulta; profissional lê o que foi
    // enviado, nunca escreve — o formulário é informação da família, não
    // um campo que o profissional edita por cima.
    match /pre_visit_questionnaires/{appointmentId} {
      allow read: if signedIn()
                  && (resource.data.patientId == request.auth.uid ||
                      resource.data.professionalId == request.auth.uid);

      // Só escreve enquanto o agendamento ainda não começou de verdade —
      // depois de `inProgress`/`completed`, o questionário vira histórico
      // do que a família disse ANTES, não deveria mudar depois do fato.
      // `get()` no agendamento correspondente, não duplicando o status
      // aqui no documento do questionário.
      //
      // Duas checagens contra o agendamento real, não só contra o próprio
      // uid de quem escreve: sem a primeira (patientId), qualquer um
      // conseguiria injetar um questionário fingindo ser paciente de uma
      // consulta que não é dele, contanto que acertasse o professionalId.
      allow create, update: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.patientId ==
                       get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId
                    && request.resource.data.professionalId ==
                       get(/databases/$(database)/documents/appointments/$(appointmentId)).data.professionalId
                    && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.status
                       in ['requested', 'confirmed'];

      allow delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      // Coleção sem escritor nem leitor em todo o projeto — receita de
      // verdade é `clinical_documents` com `type: prescription`. Provável
      // resíduo de um modelo de dado anterior. Não "corrigida" com o mesmo
      // cuidado das outras acima porque não há dado real exposto aqui: a
      // regra abaixo tem o mesmo bug de comparação (patientId de criança
      // contra uid), mas nada grava nem lê por este caminho para explorar.
      allow read: if signedIn()
                  && (resource.data.patientId == request.auth.uid ||
                      resource.data.professionalId == request.auth.uid);
      // Emissão passa por Function, que assina digitalmente.
      allow write: if false;
    }

    // ------------------------------------------ Prontuário eletrônico

    match /encounters/{encounterId} {
      // O responsável lê o prontuário da própria família; o profissional lê o
      // que ele mesmo conduziu. Admin não entra — prontuário não é dado
      // operacional da equipe.
      //
      // `patientId` é id de criança, não de usuário — comparar direto com
      // `request.auth.uid` nunca bateria (bug real, corrigido: nenhuma tela
      // de responsável usava este caminho ainda, por isso nunca foi pego).
      allow read: if signedIn()
                  && (ownsChild(resource.data.patientId) ||
                      resource.data.professionalId == request.auth.uid);

      // Só profissional verificado abre atendimento, e só em nome próprio.
      allow create: if isVerifiedProfessional()
                    && request.resource.data.professionalId == request.auth.uid
                    && request.resource.data.get('status', '') == 'draft'
                    && request.resource.data.get('signedAt', null) == null
                    && request.resource.data.get('signatureHash', null) == null;

      // Edição só enquanto rascunho, e nunca nos campos de assinatura —
      // assinar é ato da Function, que calcula o hash sobre o servidor.
      allow update: if isVerifiedProfessional()
                    && resource.data.professionalId == request.auth.uid
                    && resource.data.status == 'draft'
                    && !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['status', 'signedAt', 'signedBy',
                                     'signatureHash', 'signatureProvider',
                                     'externalSignatureId', 'patientId',
                                     'professionalId', 'amendsEncounterId']);

      // Prontuário não se apaga. Retenção é exigência legal, e apagar
      // atendimento é justamente o que não pode acontecer.
      allow delete: if false;
    }

    match /clinical_documents/{documentId} {
      // Mesmo bug do encounters: patientId é id de criança, corrigido para
      // usar ownsChild() em vez de comparar direto com o uid do usuário.
      allow read: if signedIn()
                  && (ownsChild(resource.data.patientId) ||
                      resource.data.professionalId == request.auth.uid);
      // Emissão e cancelamento passam por Function: código de verificação e
      // hash precisam ser gerados no servidor para valerem como conferência.
      allow write: if false;
    }

    // Resumo pós-consulta: `patientId` aqui é id de criança, herdado da
    // mesma convenção de `Encounter` (o resumo vive por `encounterId`) —
    // por isso já nasce usando `ownsChild()`, não a comparação direta que
    // precisou ser corrigida em encounters/clinical_documents/lab_results.
    match /visit_summaries/{encounterId} {
      // Família só vê depois de liberado — rascunho é só do profissional
      // enquanto está revisando. É a regra que garante isso, não a tela.
      allow read: if signedIn()
                  && ((ownsChild(resource.data.patientId) &&
                       resource.data.status == 'released') ||
                      resource.data.professionalId == request.auth.uid);

      allow create: if isVerifiedProfessional()
                    && request.resource.data.professionalId == request.auth.uid
                    && request.resource.data.status == 'draft';

      // Só o próprio autor edita, e não pode reatribuir o resumo para
      // outro paciente ou profissional no meio do caminho. Uma vez
      // `released`, nenhuma atualização é permitida — imutável de
      // verdade, não só por convenção da tela. Correção depois de
      // liberado passa pelo `create` acima, como um documento novo
      // (retificação), nunca por aqui.
      //
      // A sequência de transição também é imposta aqui, não só no
      // repositório — sem isso, uma escrita direta ao Firestore (sem
      // passar pelo app) poderia pular de `draft` para `released` sem
      // nunca passar por `finalized`.
      allow update: if isVerifiedProfessional()
                    && resource.data.professionalId == request.auth.uid
                    && resource.data.status != 'released'
                    && request.resource.data.professionalId == resource.data.professionalId
                    && request.resource.data.patientId == resource.data.patientId
                    && (
                         (resource.data.status == 'draft' &&
                          request.resource.data.status in ['draft', 'finalized']) ||
                         (resource.data.status == 'finalized' &&
                          request.resource.data.status in ['finalized', 'released'])
                       );

      allow delete: if false;
    }

    match /lab_results/{resultId} {
      // Duas correções na mesma regra:
      // 1. `patientId == request.auth.uid` nunca batia para o responsável
      //    (mesmo bug de encounters/clinical_documents — patientId é id de
      //    criança). Trocado por ownsChild().
      // 2. `&&` liga mais forte que `||` — a regra antiga, sem parênteses,
      //    equivalia a `(signedIn() && dono) || qualquerProfissional`, ou
      //    seja, QUALQUER profissional verificado lia exame de QUALQUER
      //    criança, não só das que atende. saveLabResults agora grava
      //    `professionalId`, e é isso que a regra passa a exigir.
      allow read: if signedIn()
                  && (ownsChild(resource.data.patientId) ||
                      resource.data.professionalId == request.auth.uid);
      allow create: if isVerifiedProfessional()
                    && request.resource.data.professionalId == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('professionalId', 'patientId');
      allow delete: if false;
    }

    // Registro de uso da IA em prontuário. Ninguém lê pelo cliente — existe
    // para auditoria interna.
    match /ai_clinical_log/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------ Consultorio 360 / voz

    // Sessoes de consulta por voz: leitura pelo profissional dono ou admin;
    // escrita apenas pelo servidor (Cloud Functions).
    match /voice_sessions/{id} {
      allow read: if signedIn() &&
                     (resource.data.professionalId == request.auth.uid ||
                      isAdmin());
      allow write: if false;
    }

    // Triagem: profissional verificado dono do registro; responsavel le se
    // ownsChild(childId) quando o campo estiver presente.
    match /triage_records/{id} {
      allow read: if (isVerifiedProfessional() &&
                      resource.data.professionalId == request.auth.uid) ||
                     (signedIn() &&
                      resource.data.keys().hasAny(['childId']) &&
                      ownsChild(resource.data.childId));
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.professionalId == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('professionalId', 'childId');
      allow delete: if false;
    }

    // Marcos do desenvolvimento — mesma politica da triagem.
    match /development_records/{id} {
      allow read: if (isVerifiedProfessional() &&
                      resource.data.professionalId == request.auth.uid) ||
                     (signedIn() &&
                      resource.data.keys().hasAny(['childId']) &&
                      ownsChild(resource.data.childId));
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.professionalId == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('professionalId', 'childId');
      allow delete: if false;
    }

    match /clinic_audit_logs/{id} {
      allow read, write: if false;
    }

    // ------------------------------------------------------- Gamificação

    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if signedIn();
      allow write: if false; // calculado por Function agendada
    }

    // Pedidos de exclusão de conta. O titular vê o próprio; a execução é da
    // Function agendada.
    match /deletion_requests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }


    // ------------------------------------------ Suplementacao Pediatrica

    match /supplement_lab_results/{id} {
      allow read: if (isVerifiedProfessional() &&
                      resource.data.recordedBy == request.auth.uid) ||
                     (signedIn() &&
                      resource.data.keys().hasAny(['childId']) &&
                      ownsChild(resource.data.childId));
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.recordedBy == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('recordedBy', 'childId');
      allow delete: if false;
    }

    match /supplement_prescriptions/{id} {
      allow read: if (isVerifiedProfessional() &&
                      resource.data.professionalId == request.auth.uid) ||
                     (signedIn() &&
                      resource.data.keys().hasAny(['childId']) &&
                      ownsChild(resource.data.childId) &&
                      resource.data.status == 'confirmed');
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.professionalId == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('professionalId', 'childId');
      allow delete: if false;
    }

    match /supplement_timeline/{id} {
      allow read: if (isVerifiedProfessional() &&
                      resource.data.createdBy == request.auth.uid) ||
                     (signedIn() &&
                      resource.data.keys().hasAny(['childId']) &&
                      ownsChild(resource.data.childId));
      allow create: if isVerifiedProfessional() &&
                     request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /supplement_clinical_notes/{id} {
      allow read: if isVerifiedProfessional() &&
                     resource.data.professionalId == request.auth.uid;
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.professionalId == request.auth.uid;
      allow update: if isClinicalRecordAuthorUpdate('professionalId', 'childId');
      allow delete: if false;
    }

    match /supplement_ai_drafts/{id} {
      allow read: if isVerifiedProfessional() &&
                     resource.data.professionalId == request.auth.uid;
      allow create: if isVerifiedProfessional() &&
                    request.resource.data.professionalId == request.auth.uid;
      allow update, delete: if false;
    }

    match /supplement_audit_logs/{id} {
      allow read, write: if false;
    }

    match /supplementation/{doc=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    // ------------------------------------------ Multitenant (FASE 1)

    function clinicMemberDoc(clinicId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/clinic_memberships/$(clinicId));
    }

    // Documento do vinculo do lado da clinica - so o admin da clinica altera.
    // A copia do usuario aponta para ele pelo campo id (padrao: o uid).
    function clinicSideMemberPath(clinicId) {
      return /databases/$(database)/documents/clinics/$(clinicId)/memberships/$(clinicMemberDoc(clinicId).data.get('id', request.auth.uid));
    }

    // Ativo e papel valem pelo documento da clinica: desativar ou rebaixar
    // alguem la precisa surtir efeito mesmo que a copia do usuario fique velha.
    function isClinicMember(clinicId) {
      return signedIn() &&
             clinicId != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/clinic_memberships/$(clinicId)) &&
             clinicMemberDoc(clinicId).data.active == true &&
             clinicMemberDoc(clinicId).data.userId == request.auth.uid &&
             clinicMemberDoc(clinicId).data.clinicId == clinicId &&
             exists(clinicSideMemberPath(clinicId)) &&
             get(clinicSideMemberPath(clinicId)).data.active == true &&
             get(clinicSideMemberPath(clinicId)).data.userId == request.auth.uid;
    }

    function clinicRole(clinicId) {
      return get(clinicSideMemberPath(clinicId)).data.role;
    }

    function isClinicAdmin(clinicId) {
      return isClinicMember(clinicId) && clinicRole(clinicId) == 'clinicAdmin';
    }

    // Ledgers financeiro / faturamento / estoque (FASE 9 tenant).
    function ledgerDocClinicId() {
      return resource.data.get('clinicId', null);
    }

    function ledgerReqClinicId() {
      return request.resource.data.get('clinicId', null);
    }

    function ledgerClinicId() {
      return resource == null ? ledgerReqClinicId() : ledgerDocClinicId();
    }

    function ledgerClinicIdUnchanged() {
      return resource == null ||
             request.resource.data.get('clinicId', null) ==
               resource.data.get('clinicId', null);
    }

    function ledgerOwnerMatches() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    function isLegacyOwnerLedgerRead() {
      return isVerifiedProfessional() &&
             resource.data.ownerId == request.auth.uid &&
             ledgerDocClinicId() == null;
    }

    function isLegacyOwnerLedgerWrite() {
      return isVerifiedProfessional() &&
             ledgerOwnerMatches() &&
             (resource == null
               ? ledgerReqClinicId() == null
               : (resource.data.ownerId == request.auth.uid &&
                  ledgerDocClinicId() == null));
    }

    function financeReadRole(clinicId) {
      return isClinicMember(clinicId) &&
             clinicRole(clinicId) in
               ['clinicAdmin', 'finance', 'physician', 'healthProfessional',
                'receptionist', 'technician'];
    }

    function financeWriteRole(clinicId) {
      return isClinicMember(clinicId) &&
             clinicRole(clinicId) in ['clinicAdmin', 'finance'];
    }

    function billingWriteRole(clinicId) {
      return financeWriteRole(clinicId);
    }

    function inventoryReadRole(clinicId) {
      return isClinicMember(clinicId) &&
             clinicRole(clinicId) in
               ['clinicAdmin', 'finance', 'nursing', 'technician'];
    }

    function inventoryWriteRole(clinicId) {
      return isClinicMember(clinicId) &&
             clinicRole(clinicId) in ['clinicAdmin', 'finance'];
    }

    function canReadLedger() {
      return isVerifiedProfessional() && (
        isLegacyOwnerLedgerRead() ||
        (ledgerDocClinicId() != null && financeReadRole(ledgerDocClinicId()))
      );
    }

    // Guias, lotes e glosas carregam diagnostico (CID): fora da recepcao/tecnico.
    function billingClinicalReadRole(clinicId) {
      return isClinicMember(clinicId) &&
             clinicRole(clinicId) in
               ['clinicAdmin', 'finance', 'physician', 'healthProfessional'];
    }

    function canReadBillingClinicalLedger() {
      return isVerifiedProfessional() && (
        isLegacyOwnerLedgerRead() ||
        (ledgerDocClinicId() != null &&
         billingClinicalReadRole(ledgerDocClinicId()))
      );
    }

    function canWriteFinanceLedger() {
      return isVerifiedProfessional() &&
             ledgerClinicIdUnchanged() &&
             ledgerOwnerMatches() && (
        isLegacyOwnerLedgerWrite() ||
        (ledgerReqClinicId() != null &&
         financeWriteRole(ledgerReqClinicId()))
      );
    }

    function canWriteBillingLedger() {
      return isVerifiedProfessional() &&
             ledgerClinicIdUnchanged() &&
             ledgerOwnerMatches() && (
        isLegacyOwnerLedgerWrite() ||
        (ledgerReqClinicId() != null &&
         billingWriteRole(ledgerReqClinicId()))
      );
    }

    function canWriteInventoryLedger() {
      return isVerifiedProfessional() &&
             ledgerClinicIdUnchanged() &&
             ledgerOwnerMatches() && (
        isLegacyOwnerLedgerWrite() ||
        (ledgerReqClinicId() != null &&
         inventoryWriteRole(ledgerReqClinicId()))
      );
    }

    function canReadInventoryLedger() {
      return isVerifiedProfessional() && (
        isLegacyOwnerLedgerRead() ||
        (ledgerDocClinicId() != null &&
         inventoryReadRole(ledgerDocClinicId()))
      );
    }

    function canCreateFinanceAudit() {
      return isVerifiedProfessional() &&
             request.resource.data.ownerId == request.auth.uid &&
             ledgerClinicIdUnchanged() && (
        request.resource.data.get('clinicId', null) == null ||
        financeWriteRole(request.resource.data.clinicId)
      );
    }

    match /clinics/{clinicId} {
      allow read: if isClinicMember(clinicId) || isAdmin() ||
                     (signedIn() &&
                      resource.data.get('ownerUserId', '') == request.auth.uid);
      // Criacao: profissional autenticado (onboarding). Admin plataforma tambem.
      // ownerUserId obriga o criador a se identificar — usado no 1o membership.
      allow create: if signedIn() &&
                       (isVerifiedProfessional() || isAdmin()) &&
                       isValidString('name', 200) &&
                       request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isClinicAdmin(clinicId) || isAdmin();
      allow delete: if false;

      match /units/{unitId} {
        allow read: if isClinicMember(clinicId) || isAdmin();
        allow write: if isClinicAdmin(clinicId) || isAdmin();
      }

      match /memberships/{membershipId} {
        allow read: if isClinicMember(clinicId) || isAdmin() ||
                       (signedIn() && resource.data.userId == request.auth.uid);
        // Admin da clinica, plataforma, ou dono criando o primeiro vinculo
        // clinicAdmin (onboarding — espelha ownerUserId da clinica).
        allow create: if isClinicAdmin(clinicId) || isAdmin() ||
                         (isVerifiedProfessional() &&
                          request.resource.data.userId == request.auth.uid &&
                          request.resource.data.clinicId == clinicId &&
                          request.resource.data.role == 'clinicAdmin' &&
                          request.resource.data.id == membershipId &&
                          get(/databases/$(database)/documents/clinics/$(clinicId))
                              .data.ownerUserId == request.auth.uid);
        allow update: if isClinicAdmin(clinicId) || isAdmin();
        allow delete: if false;
      }

      // Salas fisicas (FASE 2) — leitura equipe; escrita admin clinica.
      match /rooms/{roomId} {
        allow read: if isClinicMember(clinicId) || isAdmin();
        allow create, update: if isClinicAdmin(clinicId) || isAdmin();
        allow delete: if false;
      }

      // Bloqueios de agenda (FASE 2).
      match /schedule_blocks/{blockId} {
        allow read: if isClinicAgendaStaff(clinicId) || isAdmin();
        allow create, update: if isClinicAdmin(clinicId) ||
                                 isClinicReceptionOrAdmin(clinicId) ||
                                 isAdmin();
        allow delete: if isClinicAdmin(clinicId) || isAdmin();
      }

      match /audit_logs/{logId} {
        allow read: if isClinicAdmin(clinicId) || isAdmin();
        allow write: if false;
      }
    }

    // Financeiro (FASE 4 + FASE 9 tenant) — legado ownerId ou clinica.
    match /finance_receivables/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteFinanceLedger();
      allow delete: if false;
    }

    match /finance_payables/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteFinanceLedger();
      allow delete: if false;
    }

    match /finance_receipts/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteFinanceLedger();
      allow delete: if false;
    }

    match /finance_audit_logs/{id} {
      allow read: if canReadLedger();
      allow create: if canCreateFinanceAudit();
      allow update, delete: if false;
    }

    // Faturamento / convenios (FASE 5 + FASE 9).
    match /insurance_plans/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /patient_insurances/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /insurance_authorizations/{id} {
      allow read: if canReadLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /billing_guides/{id} {
      allow read: if canReadBillingClinicalLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /billing_batches/{id} {
      allow read: if canReadBillingClinicalLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /billing_glosas/{id} {
      allow read: if canReadBillingClinicalLedger();
      allow create, update: if canWriteBillingLedger();
      allow delete: if false;
    }
    match /billing_audit_logs/{id} {
      allow read: if canReadBillingClinicalLedger();
      allow create: if canCreateFinanceAudit();
      allow update, delete: if false;
    }

    // Estoque (FASE 6 + FASE 9).
    match /inventory_items/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_lots/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_movements/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_suppliers/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_purchase_orders/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_counts/{id} {
      allow read: if canReadInventoryLedger();
      allow create, update: if canWriteInventoryLedger();
      allow delete: if false;
    }
    match /inventory_audit_logs/{id} {
      allow read: if canReadInventoryLedger();
      allow create: if canCreateFinanceAudit();
      allow update, delete: if false;
    }

    // Rastreamento de status de pendencias derivadas (FASE 3 CRM).
    match /pending_tracking/{trackingId} {
      allow read: if signedIn()
                  && resource.data.professionalId == request.auth.uid;
      allow create: if isVerifiedProfessional()
                    && request.resource.data.professionalId == request.auth.uid
                    && request.resource.data.sourceKey is string
                    && request.resource.data.status is string;
      allow update: if isVerifiedProfessional()
                    && resource.data.professionalId == request.auth.uid
                    && request.resource.data.professionalId == request.auth.uid;
      allow delete: if false;
    }

    // Auditoria central (FASE 8) — append-only pelo cliente.
    match /security_audit_logs/{id} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.actorUid == request.auth.uid)
                  || (isVerifiedProfessional()
                      && resource.data.clinicId != null
                      && isClinicAdmin(resource.data.clinicId));
      allow create: if signedIn()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['actorUid', 'action', 'module', 'at'])
                    && (isVerifiedProfessional() || isAdmin())
                    && (isAdmin()
                        || request.resource.data.get('clinicId', null) == null
                        || isClinicMember(request.resource.data.clinicId));
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ Config

    match /config/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------ Cuidado multidisciplinar
    //
    // Espelha lib/shared/care/care_policy.dart e a matriz de acesso em
    // docs/homologacao/compartilhamento-seletivo/RELATORIO.md. O acesso vem do
    // vínculo do profissional com a criança (members/{uid}), autorizado pela
    // família, e da especialidade conferida (users/{uid}.careSpecialty).
    // Vínculo e mesma clínica não abrem registros: o registro completo é do
    // autor; a equipe recebe só o resumo que o autor escolheu e endereçou, ou
    // um acesso concedido com justificativa. A gestão da clínica organiza a
    // equipe mas não lê registros.

    function careKinds(s) {
      return s == 'pediatria'
          ? ['avaliacao', 'evolucao', 'objetivos', 'orientacao']
        : s == 'psicologia'
          ? ['avaliacao', 'sessao', 'planoTerapeutico', 'objetivos',
             'orientacao']
        : s == 'fisioterapia'
          ? ['avaliacaoFuncional', 'objetivos', 'planoSessoes', 'intervencao',
             'evolucao', 'medida', 'atividadeCasa', 'orientacao']
        : s in ['fonoaudiologia', 'terapiaOcupacional']
          ? ['avaliacao', 'objetivos', 'evolucao', 'atividadeCasa',
             'orientacao']
        : s == 'nutricao'
          ? ['avaliacao', 'objetivos', 'evolucao', 'orientacao']
        : [];
    }

    function careDocKinds(s) {
      return s == 'pediatria'
          ? ['atestadoMedico', 'receituario', 'solicitacaoExames',
             'declaracaoComparecimento', 'encaminhamento', 'orientacoes']
        : s == 'psicologia'
          ? ['declaracaoComparecimento', 'relatorioPsicologico',
             'encaminhamento', 'orientacoes']
        : s == 'fisioterapia'
          ? ['declaracaoComparecimento', 'relatorioFisioterapeutico',
             'planoExerciciosCasa', 'encaminhamento', 'orientacoes']
        : s in ['fonoaudiologia', 'terapiaOcupacional', 'nutricao']
          ? ['declaracaoComparecimento', 'encaminhamento', 'orientacoes']
        : [];
    }

    function userCareSpecialty(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
                .get('careSpecialty', '');
    }

    match /care_teams/{childId} {
      function teamPath() {
        return /databases/$(database)/documents/care_teams/$(childId);
      }

      function memberPath(uid) {
        return /databases/$(database)/documents/care_teams/$(childId)/members/$(uid);
      }

      function recordPath(rid) {
        return /databases/$(database)/documents/care_teams/$(childId)/records/$(rid);
      }

      function grantPath(rid, uid) {
        return /databases/$(database)/documents/care_teams/$(childId)/records/$(rid)/grants/$(uid);
      }

      function summaryPath(rid) {
        return /databases/$(database)/documents/care_teams/$(childId)/summaries/$(rid);
      }

      function member() {
        return get(memberPath(request.auth.uid)).data;
      }

      // Vínculo ativo (autorizado pela família e não encerrado).
      function activeMember() {
        return isVerifiedProfessional() &&
               exists(memberPath(request.auth.uid)) &&
               member().status == 'active';
      }

      function sameClinic(clinicId) {
        return member().clinicId == clinicId;
      }

      // Outro profissional com vínculo ativo na clínica indicada.
      function activeColleague(uid, clinicId) {
        return exists(memberPath(uid)) &&
               get(memberPath(uid)).data.status == 'active' &&
               get(memberPath(uid)).data.clinicId == clinicId;
      }

      // Acesso ao registro completo concedido pelo autor e não retirado.
      function hasGrant(rid) {
        return exists(grantPath(rid, request.auth.uid)) &&
               get(grantPath(rid, request.auth.uid)).data
                 .get('revokedAt', null) == null;
      }

      function careGuardian() {
        return ownsChild(childId) ||
               (exists(teamPath()) &&
                isLinkedGuardianOf(get(teamPath()).data.ownerUid, childId));
      }

      // Pedido de vínculo: sempre pendente, para profissional verificado com
      // a especialidade conferida, feito pela gestão da clínica ou pelo
      // próprio profissional (aceite de encaminhamento) na clínica dele.
      function newPendingRequest(uid) {
        return exists(teamPath()) &&
               request.resource.data.keys().hasOnly(
                 ['specialty', 'clinicId', 'status', 'reason', 'requestedBy',
                  'since']) &&
               request.resource.data.status == 'pending' &&
               request.resource.data.requestedBy == request.auth.uid &&
               request.resource.data.since == request.time &&
               get(/databases/$(database)/documents/users/$(uid)).data
                 .get('professionalVerified', false) == true &&
               userCareSpecialty(uid) == request.resource.data.specialty &&
               (isClinicAdmin(request.resource.data.clinicId) ||
                (request.auth.uid == uid &&
                 isClinicMember(request.resource.data.clinicId)));
      }

      // Padrão privado. Só orientação e atividade para casa vão à família.
      function validVisibility(d) {
        return d.visibility in ['privado', 'familia'] &&
               (d.visibility != 'familia' ||
                d.kind in ['orientacao', 'atividadeCasa']) &&
               (d.visibility == 'familia' || d.get('releasedAt', null) == null);
      }

      // Texto preparado pela IA só é gravado revisado por quem grava.
      function aiReviewed(d) {
        return d.get('aiGenerated', false) != true ||
               d.get('reviewedBy', '') == request.auth.uid;
      }

      allow read: if activeMember() ||
                     (isVerifiedProfessional() &&
                      exists(memberPath(request.auth.uid))) ||
                     careGuardian();
      allow create: if ownsChild(childId) &&
                       request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']) &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if request.auth.uid == uid ||
                       activeMember() ||
                       isClinicAdmin(resource.data.clinicId) ||
                       careGuardian();
        allow create: if newPendingRequest(uid);
        // Família autoriza.
        function familyAuthorizes() {
          return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'authorizedAt', 'authorizedBy']) &&
                 request.resource.data.authorizedBy == request.auth.uid &&
                 request.resource.data.authorizedAt == request.time &&
                 careGuardian();
        }

        // Encerram: o próprio profissional, a gestão da clínica ou a família.
        function endsLink(uid) {
          return request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'endedAt', 'endedBy', 'endReason']) &&
                 request.resource.data.endedBy == request.auth.uid &&
                 request.resource.data.endedAt == request.time &&
                 (request.auth.uid == uid ||
                  isClinicAdmin(resource.data.clinicId) ||
                  careGuardian());
        }

        // Transições explícitas em ternário: no emulador, `false && (f() || x)`
        // com f() = careGuardian() chegou a liberar a escrita. Por isso
        // careGuardian() fica sempre por último nas disjunções deste bloco.
        allow update: if
          (resource.data.status == 'pending' &&
           request.resource.data.status == 'active')
            ? familyAuthorizes()
          : (resource.data.status in ['pending', 'active'] &&
             request.resource.data.status == 'ended')
            ? endsLink(uid)
          // Novo pedido depois de encerrado (outra clínica, por exemplo).
          : (resource.data.status == 'ended' &&
             request.resource.data.status == 'pending')
            ? newPendingRequest(uid)
          : false;
        allow delete: if false;
      }

      // Registro completo: o autor; quem recebeu acesso justificado (com
      // vínculo ativo na mesma clínica); a família, só o que foi liberado.
      match /records/{recordId} {
        allow read: if signedIn() && (
          resource.data.authorUid == request.auth.uid ||
          (activeMember() && sameClinic(resource.data.clinicId) &&
           hasGrant(recordId)) ||
          (resource.data.visibility == 'familia' &&
           resource.data.get('releasedAt', null) != null &&
           careGuardian()));
        allow create: if activeMember() &&
                         request.resource.data.authorUid == request.auth.uid &&
                         request.resource.data.specialty == member().specialty &&
                         request.resource.data.clinicId == member().clinicId &&
                         request.resource.data.kind in careKinds(member().specialty) &&
                         validVisibility(request.resource.data) &&
                         request.resource.data.revision == 1 &&
                         request.resource.data.createdAt == request.time &&
                         aiReviewed(request.resource.data);
        // Toda alteração grava, no mesmo lote, a revisão com o texto anterior.
        allow update: if activeMember() &&
                         resource.data.authorUid == request.auth.uid &&
                         sameClinic(resource.data.clinicId) &&
                         !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['authorUid', 'specialty', 'clinicId', 'kind',
                                     'createdAt', 'aiGenerated']) &&
                         validVisibility(request.resource.data) &&
                         request.resource.data.revision == resource.data.revision + 1 &&
                         existsAfter(/databases/$(database)/documents/care_teams/$(childId)/records/$(recordId)/revisions/$(string(request.resource.data.revision))) &&
                         aiReviewed(request.resource.data);
        allow delete: if false;

        match /revisions/{rev} {
          allow read: if signedIn() &&
                         get(recordPath(recordId)).data.authorUid == request.auth.uid;
          allow create: if activeMember() &&
                           get(recordPath(recordId)).data.authorUid == request.auth.uid &&
                           request.resource.data.actorUid == request.auth.uid &&
                           request.resource.data.at == request.time &&
                           request.resource.data.keys().hasAll(
                             ['actorUid', 'at', 'note', 'previousBody']);
          allow update, delete: if false;
        }

        // Partes do registro. Anotação privada, transcrição e conversa ficam
        // só com o autor, inclusive para quem recebeu acesso ao registro.
        match /sections/{sectionId} {
          allow read: if signedIn() && (
            get(recordPath(recordId)).data.authorUid == request.auth.uid ||
            (resource.data.kind == 'clinica' &&
             activeMember() &&
             sameClinic(get(recordPath(recordId)).data.clinicId) &&
             hasGrant(recordId)));
          allow create: if activeMember() &&
                           getAfter(recordPath(recordId)).data.authorUid == request.auth.uid &&
                           request.resource.data.keys().hasOnly(
                             ['kind', 'label', 'text', 'createdAt']) &&
                           request.resource.data.kind in
                             ['clinica', 'anotacaoPrivada', 'transcricao', 'conversa'] &&
                           request.resource.data.createdAt == request.time;
          allow update: if activeMember() &&
                           get(recordPath(recordId)).data.authorUid == request.auth.uid &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['label', 'text']);
          allow delete: if false;
        }

        // Acesso ao registro completo, um por profissional (id = uid de quem
        // recebe). Só o autor concede, com justificativa, a colega com vínculo
        // ativo na mesma clínica. Retirar não apaga: grava quem, quando e por
        // quê. Uma nova concessão guarda antes a anterior em history/{rodada}.
        match /grants/{granteeUid} {
          function rec() {
            return get(recordPath(recordId)).data;
          }

          function validGrant(d) {
            return d.keys().hasOnly(
                     ['granteeUid', 'clinicId', 'justification', 'grantedAt',
                      'grantedBy', 'round']) &&
                   d.granteeUid == granteeUid &&
                   granteeUid != request.auth.uid &&
                   d.clinicId == rec().clinicId &&
                   d.justification is string &&
                   d.justification.size() >= 15 &&
                   d.justification.size() <= 500 &&
                   d.grantedAt == request.time &&
                   d.grantedBy == request.auth.uid &&
                   activeMember() &&
                   rec().authorUid == request.auth.uid &&
                   sameClinic(rec().clinicId) &&
                   activeColleague(granteeUid, rec().clinicId);
          }

          allow read: if signedIn() &&
                         (request.auth.uid == granteeUid ||
                          rec().authorUid == request.auth.uid);
          allow create: if validGrant(request.resource.data) &&
                           request.resource.data.round == 1;
          allow update: if
            (resource.data.get('revokedAt', null) == null)
              // Retirada: o autor, mesmo depois de encerrado o próprio vínculo.
              ? (rec().authorUid == request.auth.uid &&
                 request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['revokedAt', 'revokedBy', 'revokeReason']) &&
                 request.resource.data.revokedAt == request.time &&
                 request.resource.data.revokedBy == request.auth.uid &&
                 request.resource.data.revokeReason is string &&
                 request.resource.data.revokeReason.size() >= 3)
              // Nova concessão depois de retirada.
              : (validGrant(request.resource.data) &&
                 request.resource.data.round == resource.data.round + 1 &&
                 existsAfter(/databases/$(database)/documents/care_teams/$(childId)/records/$(recordId)/grants/$(granteeUid)/history/$(string(resource.data.round))));
          allow delete: if false;

          match /history/{round} {
            allow read: if signedIn() &&
                           get(recordPath(recordId)).data.authorUid == request.auth.uid;
            allow create: if signedIn() &&
                             get(recordPath(recordId)).data.authorUid == request.auth.uid &&
                             request.resource.data.keys().hasAll(
                               ['justification', 'grantedAt', 'revokedAt',
                                'revokedBy', 'revokeReason']);
            allow update, delete: if false;
          }
        }
      }

      // Resumo para a equipe (id = registro de origem). É uma cópia, feita
      // pelo autor, só dos itens que ele marcou, endereçada a profissionais
      // escolhidos. Cada publicação, atualização ou encerramento sobe a
      // versão e grava a versão em versions/{n} no mesmo lote.
      match /summaries/{recordId} {
        function validSummary(d) {
          return d.keys().hasOnly(
                   ['authorUid', 'clinicId', 'specialty', 'recordTitle',
                    'status', 'audience', 'recipients', 'items', 'attachments',
                    'note', 'version', 'createdAt', 'updatedAt', 'aiAssisted',
                    'reviewedBy']) &&
                 d.authorUid == request.auth.uid &&
                 d.status in ['publicado', 'encerrado'] &&
                 d.audience in ['selecionados', 'equipe'] &&
                 d.recipients is list &&
                 d.recipients.size() >= 1 &&
                 d.recipients.size() <= 30 &&
                 !(request.auth.uid in d.recipients) &&
                 d.items is list &&
                 d.items.size() <= 30 &&
                 d.attachments is list &&
                 d.attachments.size() <= 10 &&
                 d.updatedAt == request.time &&
                 (d.get('aiAssisted', false) != true ||
                  d.get('reviewedBy', '') == request.auth.uid) &&
                 existsAfter(/databases/$(database)/documents/care_teams/$(childId)/summaries/$(recordId)/versions/$(string(d.version)));
        }

        allow read: if signedIn() && (
          resource.data.authorUid == request.auth.uid ||
          (resource.data.status == 'publicado' &&
           request.auth.uid in resource.data.recipients &&
           activeMember() &&
           sameClinic(resource.data.clinicId)));
        allow create: if activeMember() &&
                         get(recordPath(recordId)).data.authorUid == request.auth.uid &&
                         validSummary(request.resource.data) &&
                         request.resource.data.clinicId == get(recordPath(recordId)).data.clinicId &&
                         request.resource.data.specialty == get(recordPath(recordId)).data.specialty &&
                         request.resource.data.status == 'publicado' &&
                         request.resource.data.version == 1 &&
                         request.resource.data.createdAt == request.time;
        // Atualizar exige vínculo ativo; encerrar o acesso, só ser o autor.
        allow update: if resource.data.authorUid == request.auth.uid &&
                         validSummary(request.resource.data) &&
                         !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['authorUid', 'clinicId', 'specialty',
                                     'recordTitle', 'createdAt']) &&
                         request.resource.data.version == resource.data.version + 1 &&
                         (request.resource.data.status == 'encerrado'
                            ? true
                            : (activeMember() &&
                               sameClinic(resource.data.clinicId)));
        allow delete: if false;

        // Histórico de versões: só o autor, imutável.
        match /versions/{version} {
          allow read: if signedIn() &&
                         get(summaryPath(recordId)).data.authorUid == request.auth.uid;
          allow create: if signedIn() &&
                           getAfter(summaryPath(recordId)).data.authorUid == request.auth.uid &&
                           request.resource.data.version == int(version) &&
                           request.resource.data.actorUid == request.auth.uid &&
                           request.resource.data.at == request.time &&
                           request.resource.data.keys().hasAll(
                             ['version', 'actorUid', 'at', 'status', 'audience',
                              'recipients', 'items', 'attachments']);
          allow update, delete: if false;
        }

        // Quem acessou: gravado por quem lê, na versão em vigor. O autor
        // consulta; ninguém altera nem apaga.
        match /access/{accessId} {
          allow read: if signedIn() &&
                         get(summaryPath(recordId)).data.authorUid == request.auth.uid;
          allow create: if activeMember() &&
                           request.resource.data.keys().hasOnly(
                             ['readerUid', 'at', 'version']) &&
                           request.resource.data.readerUid == request.auth.uid &&
                           request.resource.data.at == request.time &&
                           get(summaryPath(recordId)).data.status == 'publicado' &&
                           request.auth.uid in get(summaryPath(recordId)).data.recipients &&
                           request.resource.data.version ==
                             get(summaryPath(recordId)).data.version;
          allow update, delete: if false;
        }
      }

      // Plano terapêutico conjunto, por clínica: a equipe de outra clínica e
      // a família não o veem. Cada objetivo tem responsável, prazo e
      // reavaliação; cada profissional contribui com o que escolhe escrever.
      match /plan/{clinicId} {
        allow read, write: if false;

        match /goals/{goalId} {
          function planMember() {
            return activeMember() && sameClinic(clinicId);
          }

          allow read: if planMember();
          allow create: if planMember() &&
                           request.resource.data.keys().hasOnly(
                             ['objective', 'responsibleUid', 'responsibleSpecialty',
                              'dueDate', 'reassessAt', 'status', 'reassessCount',
                              'createdBy', 'createdAt']) &&
                           request.resource.data.objective is string &&
                           request.resource.data.objective.size() >= 3 &&
                           request.resource.data.objective.size() <= 500 &&
                           request.resource.data.status == 'emAndamento' &&
                           request.resource.data.reassessCount == 0 &&
                           request.resource.data.createdBy == request.auth.uid &&
                           request.resource.data.createdAt == request.time &&
                           request.resource.data.dueDate is timestamp &&
                           request.resource.data.dueDate > request.time &&
                           request.resource.data.reassessAt is timestamp &&
                           request.resource.data.reassessAt <= request.resource.data.dueDate &&
                           activeColleague(request.resource.data.responsibleUid, clinicId) &&
                           get(memberPath(request.resource.data.responsibleUid)).data.specialty ==
                             request.resource.data.responsibleSpecialty;
          // Reavaliação: só o responsável, gravando o registro no mesmo lote.
          allow update: if planMember() &&
                           resource.data.responsibleUid == request.auth.uid &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'reassessAt', 'reassessCount']) &&
                           request.resource.data.status in
                             ['emAndamento', 'atingido', 'revisar'] &&
                           request.resource.data.reassessAt is timestamp &&
                           request.resource.data.reassessCount ==
                             resource.data.reassessCount + 1 &&
                           existsAfter(/databases/$(database)/documents/care_teams/$(childId)/plan/$(clinicId)/goals/$(goalId)/reassessments/$(string(request.resource.data.reassessCount)));
          allow delete: if false;

          match /reassessments/{n} {
            allow read: if planMember();
            allow create: if planMember() &&
                             getAfter(/databases/$(database)/documents/care_teams/$(childId)/plan/$(clinicId)/goals/$(goalId)).data.responsibleUid == request.auth.uid &&
                             request.resource.data.keys().hasOnly(
                               ['actorUid', 'at', 'status', 'note', 'nextReassessAt']) &&
                             request.resource.data.actorUid == request.auth.uid &&
                             request.resource.data.at == request.time;
            allow update, delete: if false;
          }

          match /contributions/{contributionId} {
            allow read: if planMember();
            allow create: if planMember() &&
                             existsAfter(/databases/$(database)/documents/care_teams/$(childId)/plan/$(clinicId)/goals/$(goalId)) &&
                             request.resource.data.keys().hasOnly(
                               ['authorUid', 'authorSpecialty', 'kind', 'text', 'at']) &&
                             request.resource.data.authorUid == request.auth.uid &&
                             request.resource.data.authorSpecialty == member().specialty &&
                             request.resource.data.kind in ['acao', 'informacao'] &&
                             request.resource.data.text is string &&
                             request.resource.data.text.size() >= 1 &&
                             request.resource.data.text.size() <= 2000 &&
                             request.resource.data.at == request.time;
            allow update, delete: if false;
          }
        }

        match /history/{entryId} {
          allow read: if activeMember() && sameClinic(clinicId);
          allow create: if activeMember() && sameClinic(clinicId) &&
                           request.resource.data.actorUid == request.auth.uid &&
                           request.resource.data.at == request.time;
          allow update, delete: if false;
        }
      }

      // Comunicação da equipe. A família não lê. O encaminhamento em aberto
      // é legível por quem pode aceitá-lo (destinatário ou especialidade).
      match /messages/{messageId} {
        function canAcceptReferral() {
          return isVerifiedProfessional() &&
                 resource.data.kind == 'encaminhamento' &&
                 resource.data.status == 'aberto' &&
                 (resource.data.get('toUid', null) == request.auth.uid ||
                  (resource.data.get('toUid', null) == null &&
                   userCareSpecialty(request.auth.uid) == resource.data.toSpecialty &&
                   isClinicMember(resource.data.clinicId)));
        }

        allow read: if (activeMember() && sameClinic(resource.data.clinicId)) ||
                       canAcceptReferral();
        allow create: if activeMember() &&
                         request.resource.data.authorUid == request.auth.uid &&
                         request.resource.data.authorSpecialty == member().specialty &&
                         request.resource.data.clinicId == member().clinicId &&
                         request.resource.data.kind in ['encaminhamento', 'parecer', 'mensagem'] &&
                         (request.resource.data.kind != 'encaminhamento' ||
                          request.resource.data.get('toSpecialty', null) != null) &&
                         request.resource.data.status == 'aberto' &&
                         request.resource.data.at == request.time;
        // Só o status muda: aceite/recusa do encaminhamento por quem pode
        // aceitá-lo, ou "respondido" pela equipe.
        allow update: if signedIn() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'statusBy', 'statusAt']) &&
                         request.resource.data.statusBy == request.auth.uid &&
                         request.resource.data.statusAt == request.time &&
                         ((canAcceptReferral() &&
                           request.resource.data.status in ['aceito', 'recusado']) ||
                          (resource.data.kind != 'encaminhamento' &&
                           activeMember() && sameClinic(resource.data.clinicId) &&
                           request.resource.data.status == 'respondido'));
        allow delete: if false;
      }

      // Documentos emitidos: do autor; a família lê o que foi liberado. A
      // equipe não lê documentos de outro profissional.
      match /documents/{docId} {
        allow read: if signedIn() && (
          resource.data.authorUid == request.auth.uid ||
          (resource.data.get('releasedAt', null) != null && careGuardian()));
        allow create: if activeMember() &&
                         request.resource.data.authorUid == request.auth.uid &&
                         request.resource.data.specialty == member().specialty &&
                         request.resource.data.clinicId == member().clinicId &&
                         request.resource.data.kind in careDocKinds(member().specialty) &&
                         request.resource.data.status == 'draft' &&
                         request.resource.data.get('releasedAt', null) == null;
        allow update: if activeMember() &&
                         resource.data.authorUid == request.auth.uid &&
                         !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['authorUid', 'specialty', 'clinicId', 'kind',
                                     'createdAt']) &&
                         ((resource.data.status == 'draft' &&
                           request.resource.data.status in ['draft', 'reviewed']) ||
                          (resource.data.status == 'reviewed' &&
                           request.resource.data.status in ['reviewed', 'issued']) ||
                          (resource.data.status == 'issued' &&
                           request.resource.data.status == 'issued' &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['releasedAt']))) &&
                         (request.resource.data.get('releasedAt', null) == null ||
                          request.resource.data.status == 'issued');
        allow delete: if false;
      }
      // Trilha de acessos e alterações: append-only. A família e a gestão
      // da clínica leem; ninguém altera nem apaga.
      match /access_log/{logId} {
        allow read: if isClinicAdmin(resource.data.get('clinicId', null)) ||
                       careGuardian();
        allow create: if signedIn() &&
                         request.resource.data.actorUid == request.auth.uid &&
                         request.resource.data.at == request.time &&
                         request.resource.data.keys().hasAll(
                           ['actorUid', 'action', 'target', 'at', 'allowed']) &&
                         ((isVerifiedProfessional() &&
                           exists(memberPath(request.auth.uid))) ||
                          careGuardian());
        allow update, delete: if false;
      }
    }

    // Modelos pessoais de documento do cuidado multidisciplinar.
    match /care_templates/{templateId} {
      allow read, delete: if signedIn() &&
                             resource.data.ownerUid == request.auth.uid;
      allow create, update: if isVerifiedProfessional() &&
                               request.resource.data.ownerUid == request.auth.uid &&
                               (resource == null ||
                                resource.data.ownerUid == request.auth.uid) &&
                               request.resource.data.kind in
                                 careDocKinds(userCareSpecialty(request.auth.uid));
    }

    // Nada além do declarado acima. Uma collection nova nasce fechada, em vez
    // de nascer pública por esquecimento.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
